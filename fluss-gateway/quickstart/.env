# Image versions / names for the quickstart compose.

# Fluss server image (CoordinatorServer + TabletServer).
FLUSS_DOCKER_VERSION=0.9.1-incubating

# Flink image bundling the Fluss connector and optional lakehouse dependencies.
FLUSS_QUICKSTART_FLINK_DOCKER_VERSION=1.20-0.9.1-incubating-rc1

# Fluss Gateway image.
FLUSS_GATEWAY_IMAGE=apache/fluss-gateway:latest

# Local S3-compatible object store used for both Fluss remote tiering and the
# Paimon warehouse.
RUSTFS_VERSION=1.0.0-alpha.83
MC_VERSION=latest

# Paimon plugin used by the Fluss servers.
PAIMON_VERSION=1.3.1
PAIMON_S3_PLUGIN_JAR=/Users/boyu/IdeaProjects/fluss-rust-community/target/tmp/paimon-s3-1.3.1.jar
